<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/cloud-storage/**/*.cs" />
    <Compile Remove="tests/memory-audit/**/*.cs" />
    <Compile Remove="tests/weather/**/*.cs" />
    <Compile Remove="tests/desktop-operator/**/*.cs" />
    <Compile Remove="desktop-companion/**/*.cs" />
    <Content Remove="tests/**" />
    <Content Remove="desktop-companion/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" Condition="'$(OS)' == 'Windows_NT'" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
</Project>
